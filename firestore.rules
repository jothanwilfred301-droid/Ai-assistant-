rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Test document connection endpoint for initial validation
    match /test/{docId} {
      allow read, write: if true;
    }

    // Per-user isolated collections for memories, tasks, deliveries, and settings
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Guest / local preview sessions
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null || sessionId.size() > 0;
    }
  }
}
